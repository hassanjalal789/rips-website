# Copy to .env for local experiments only. Real values live in the host's
# encrypted environment settings, one set per environment (Doc 07 Q13, Q14).
# Never commit real keys. Host is not chosen yet (OD-03).

# Origins allowed to post to /api/v1/enquiry (comma separated).
ALLOWED_ORIGINS=http://localhost:8080,https://rips.edu.pk

# Which adapters to use: "mock" or "google" / "smtp" / "turnstile".
# Only the mock adapters are implemented in this release (ADR-05, ADR-06, ADR-07 pending).
SHEET_ADAPTER=mock
EMAIL_ADAPTER=mock
CAPTCHA_ADAPTER=none

# Google Sheet that stores enquiries (ADR-05, OD-06, OD-15).
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Email (ADR-06, OD-04).
ADMISSIONS_EMAIL=admissions@example.com
ALERT_EMAIL=admin@example.com
EMAIL_FROM=no-reply@example.com
EMAIL_API_KEY=

# Spam check (ADR-07, OD-06). Leave empty to rely on honeypot + rate limit.
CAPTCHA_SECRET=

# Consent wording version recorded with each enquiry (Doc 08 Q22).
CONSENT_VERSION=v1
