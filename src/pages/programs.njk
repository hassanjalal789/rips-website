---
layout: page.njk
permalink: /programs/
title: Programs
crumbs: []
description: "Programs at RIPS Sheikhupura, grouped by field: duration, eligibility, fees and intake status."
---
{#- Programs list (Doc 05; Doc 06 Q10: grouped by field). #}
<h1>Programs</h1>
<p class="lead">Every program at RIPS, grouped by field. {% tbc "final program list and names", "OD-07" %}</p>
{%- set programs = collections.programs | activePrograms %}
{%- for field, items in programs | groupby("data.field") -%}
<section aria-labelledby="field-{{ loop.index }}">
  <h2 id="field-{{ loop.index }}">{{ field }}</h2>
  <ul class="grid grid-3">
    {%- for p in items %}
    {%- set pstatus = (intakes | intakeFor(p.data.slug)) | intakeStatus(build.today) %}
    <li class="card">
      <div class="card-media" aria-hidden="true">{{ p.data.title | initials }}</div>
      <div class="card-body">
        <h3><a href="/programs/{{ p.data.slug }}/">{{ p.data.title }}</a></h3>
        <p class="card-meta">{{ p.data.level }}</p>
        <p class="card-meta">{% if pstatus %}<span class="badge badge-{{ pstatus.key }}">{{ pstatus.label }}</span>{% endif %}{% if not p.data.confirmed %} <span class="sample-tag">SAMPLE</span>{% endif %}</p>
      </div>
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endfor %}
