---
layout: page.njk
permalink: /programs/
title: Programs
crumbs: []
description: "Programs at RIPS Sheikhupura, grouped by field: duration, eligibility, fees and intake status."
pageScript: filters
---
{#- Programs list (Doc 05 Q18: filter by field and level; Doc 06 Q10: grouped by field). #}
<h1>Programs</h1>
<p class="lead">Every program at RIPS, grouped by field. {% tbc "final program list and names", "OD-07" %}</p>
{%- set programs = collections.programs | activePrograms %}
<form class="program-filters" action="/programs/" method="get" data-filters="program">
  <fieldset class="filters filters-2">
    <legend>Filter programs</legend>
    <div class="field">
      <label for="f-field">Field</label>
      <select id="f-field" name="field">
        <option value="">All fields</option>
        {%- for field, items in programs | groupby("data.field") %}
        <option>{{ field }}</option>
        {%- endfor %}
      </select>
    </div>
    <div class="field">
      <label for="f-level">Level</label>
      <select id="f-level" name="level">
        <option value="">All levels</option>
        {%- for level, items in programs | groupby("data.level") %}
        <option>{{ level }}</option>
        {%- endfor %}
      </select>
    </div>
    <div class="filter-actions">
      <button class="btn btn-secondary" type="submit" data-filter-submit>Show programs</button>
      <button class="btn btn-text" type="button" data-filter-clear>Clear filters</button>
    </div>
  </fieldset>
</form>
<p class="filter-count" role="status" data-filter-count>{{ programs.length }} programs shown</p>
{%- for field, items in programs | groupby("data.field") -%}
<section aria-labelledby="field-{{ loop.index }}" data-filter-group>
  <h2 id="field-{{ loop.index }}">{{ field }}</h2>
  <ul class="grid grid-3">
    {%- for p in items %}
    {%- set pstatus = (intakes | intakeFor(p.data.slug)) | intakeStatus(build.today) %}
    <li class="card" data-filter-item data-field="{{ p.data.field }}" data-level="{{ p.data.level }}">
      <div class="card-media" aria-hidden="true">{{ (p.data.short or p.data.title) | programMark }}</div>
      <div class="card-body">
        <h3><a href="/programs/{{ p.data.slug }}/">{{ p.data.title }}</a></h3>
        <p class="card-meta">{{ p.data.level }}</p>
        <p class="card-meta">{% if pstatus %}<span class="badge badge-{{ pstatus.key }}">{{ pstatus.label }}</span>{% endif %}{% if not p.data.confirmed %} <span class="sample-tag">SAMPLE</span>{% endif %}</p>
      </div>
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endfor %}
<div class="empty-state" data-filter-empty hidden>
  <p>No programs match these filters.</p>
  <p><button class="btn btn-secondary" type="button" data-filter-clear>Clear filters</button></p>
  <p>Not sure what to study? <a href="/enquire/">Ask admissions</a>.</p>
</div>
