---
layout: page.njk
crumbs: [{ label: Programs, url: /programs/ }]
---
{#- Program page (Doc 06 Program checklist): breadcrumb → name and status badge → key facts → Enquire →
    overview → outline → careers → fee link → related programs and notices → last updated.
    A withdrawn or not-offered program keeps its page with a badge (Doc 05 Q19, Q23). #}
{%- set intake = intakes | intakeFor(slug) -%}
{%- set status = intake | intakeStatus(build.today) -%}
{%- set fee = fees | feeFor(slug) -%}
<h1>{{ title }}</h1>
<p class="program-status">
  {%- if status and page.data.status == "Active" %}<span class="badge badge-{{ status.key }}">{{ status.label }}</span>{% endif %}
  {%- if page.data.status == "Not offered this intake" %}<span class="badge badge-not-offered">Not offered this intake</span>{% endif %}
  {%- if page.data.status == "Withdrawn" %}<span class="badge badge-withdrawn">Not currently offered</span>{% endif %}
  {%- if not confirmed %} <span class="sample-tag">SAMPLE, OD-07</span>{% endif %}
</p>
<section class="key-facts" aria-labelledby="key-facts">
  <h2 id="key-facts">Key facts</h2>
  <dl>
    <dt>Level</dt><dd>{{ level }}</dd>
    <dt>Duration</dt><dd>{{ duration | tbc("duration", "OD-07") | safe }}</dd>
    <dt>Eligibility</dt><dd>{{ eligibility | tbc("eligibility", "OD-07") | safe }}</dd>
    <dt>Fee per year</dt><dd>{% if fee_per_year_pkr %}{{ fee_per_year_pkr | pkr }}{% else %}Contact admissions for current fees{% endif %} · <a href="/admissions/fees/">Fee details</a></dd>
    <dt>Affiliation</dt><dd>{{ affiliation | tbc("affiliating university", "OD-08") | safe }}</dd>
    <dt>Intake</dt><dd>{% if intake %}{{ intake.session }}: {{ intake.opens_on | displayDate }} to {{ intake.closes_on | displayDate }}{% if intake.sample %} <span class="sample-tag">SAMPLE</span>{% endif %}{% else %}{% tbc "intake dates", "OD-07" %}{% endif %}</dd>
  </dl>
</section>
<p class="btn-row"><a class="btn btn-primary" href="/enquire/?program={{ slug }}">Enquire about {{ short or title }}</a></p>
<div class="prose">
  <h2>Overview</h2>
  {{ content | safe }}
  <h2>What you will study</h2>
  {%- if outline %}
  {{ outline | safe }}
  {%- else %}
  <p>{% tbc "program outline from the Head of Department", "OD-07" %}</p>
  {%- endif %}
  <h2>Careers</h2>
  {%- if careers %}
  {{ careers | safe }}
  {%- else %}
  <p>{% tbc "careers this program leads to", "OD-07" %}</p>
  {%- endif %}
  <h2>Fees</h2>
  <p>{% if fee_per_year_pkr %}{{ fee_per_year_pkr | pkr }} per year.{% else %}Contact admissions for current fees.{% endif %} The <a href="/admissions/fees/">fee structure</a> shows every fee for {{ short or title }}{% if fee %}, session {{ fee.session }}{% endif %}.</p>
</div>

{%- set related = collections.programs | sameField({ field: field, slug: slug }) %}
{%- if related.length %}
<section class="related" aria-labelledby="related-programs">
  <h2 id="related-programs">Related programs</h2>
  <ul class="related-list">
    {%- for p in related.slice(0, 3) %}
    <li><a href="/programs/{{ p.data.slug }}/">{{ p.data.title }}</a></li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}
{%- set pnotices = collections.notices | currentNotices(build.today) | forProgram(slug) %}
<section class="related" aria-labelledby="program-notices">
  <h2 id="program-notices">Notices for {{ short or title }}</h2>
  {%- if pnotices.length %}
  <ul class="notice-list">
    {%- for n in pnotices.slice(0, 5) %}
    {%- set headingTag = "h3" %}
    {% include "partials/notice-row.njk" %}
    {%- endfor %}
  </ul>
  {%- else %}
  <p class="muted">Nothing posted yet.</p>
  {%- endif %}
  <p><a href="/notices/?program={{ slug }}">All {{ short or title }} notices <span aria-hidden="true">→</span></a></p>
</section>
<p class="last-updated">Last updated {{ last_updated | displayDate }}</p>
