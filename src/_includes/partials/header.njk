<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href="/">
      <img src="/assets/img/crest.webp" alt="" width="44" height="43">
      <span class="brand-name"><strong>RIPS</strong><span class="brand-long">{{ settings.name }}</span></span>
    </a>
    {#- Full-screen menu below 1024px, numbered 01–07 (motion storyboard S6); a plain row above. #}
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ol class="nav-list">
        {%- for item in nav.main %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% elif page.url and page.url.startsWith(item.url) %} class="is-section"{% endif %}><span class="nav-num" aria-hidden="true">{{ "0" + loop.index }}</span><span class="nav-label">{{ item.label }}</span></a></li>
        {%- endfor %}
        <li class="nav-enquire"><a href="/enquire/"{% if page.url == "/enquire/" %} aria-current="page"{% endif %}><span class="nav-num" aria-hidden="true">{{ "0" + (nav.main.length + 1) }}</span><span class="nav-label">Enquire</span></a></li>
      </ol>
      <p class="nav-extra">{{ settings.tagline }}</p>
    </nav>
    <a class="btn btn-primary header-enquire" href="/enquire/">Enquire</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span class="menu-icon" aria-hidden="true"></span><span class="menu-label">Menu</span></button>
  </div>
</header>
