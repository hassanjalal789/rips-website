<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href="/">
      <img src="/assets/img/crest.webp" alt="" width="44" height="43">
      <span class="brand-name"><strong>RIPS</strong><span class="brand-long">{{ settings.name }}</span></span>
    </a>
    {#- A drop-down list under the header below 1024px; a plain row above (CR-02). #}
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="nav-list">
        {%- for item in nav.main %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% elif page.url and page.url.startsWith(item.url) %} class="is-section"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        <li class="nav-enquire"><a href="/enquire/"{% if page.url == "/enquire/" %} aria-current="page"{% endif %}>Enquire</a></li>
      </ul>
    </nav>
    {#- Call and WhatsApp icons beside Enquire on wide screens (Doc 05 Q08); each has a text label (Q31). #}
    <a class="header-icon" href="tel:{{ settings.phone_link }}"{% if not settings.phone %} data-placeholder="OD-14"{% endif %}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
      <span class="visually-hidden">Call admissions</span>
    </a>
    <a class="header-icon" href="https://wa.me/{{ settings.whatsapp_link }}?text={{ settings.whatsapp_message | urlencode }}" rel="noopener"{% if not settings.whatsapp %} data-placeholder="OD-14"{% endif %}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.1.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3Z"/></svg>
      <span class="visually-hidden">WhatsApp admissions (opens WhatsApp)</span>
    </a>
    <a class="btn btn-primary header-enquire" href="/enquire/">Enquire</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span class="menu-icon" aria-hidden="true"></span><span class="menu-label">Menu</span></button>
  </div>
</header>
