<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <img src="/assets/img/{{ "crest-gold.webp" if (bodyClass and "cine-page" in bodyClass) else "crest.webp" }}" alt="" width="44" height="43" loading="lazy">
          <span class="brand-name"><strong>RIPS</strong><span>{{ settings.name }}</span></span>
        </a>
        <p class="footer-tagline">{{ settings.tagline }}</p>
        <p>{{ settings.address | tbc("verified address", "OD-14") | safe }}</p>
      </div>
      <div>
        <h2>Study</h2>
        <ul>
          <li><a href="/programs/">Programs</a></li>
          <li><a href="/admissions/">Admissions</a></li>
          <li><a href="/admissions/fees/">Fees</a></li>
          <li><a href="/notices/">Notices</a></li>
        </ul>
      </div>
      <div>
        <h2>About</h2>
        <ul>
          <li><a href="/why-rips/">Why RIPS?</a></li>
          {%- for item in nav.about %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor %}
          <li><a href="/news/">News &amp; Events</a></li>
        </ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul>
          <li>Phone: {{ settings.phone | tbc("admissions phone", "OD-14") | safe }}</li>
          <li>WhatsApp: {{ settings.whatsapp | tbc("WhatsApp number", "OD-14") | safe }}</li>
          {%- if settings.office_numbers %}
          <li>Office numbers: {% for n in settings.office_numbers %}<a href="tel:{{ n.link }}">{{ n.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</li>
          {%- endif %}
          <li>Email: {{ settings.email | tbc("admissions email", "OD-04") | safe }}</li>
          <li>Office hours: {{ settings.office_hours | tbc("office hours", "OD-14") | safe }}</li>
          <li><a href="/contact/">Contact page</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <p>The official RIPS website is {{ settings.url | replace("https://", "") }}. RIPS never asks for fees to be paid into a personal account.</p>
      <p>© {{ build.year }} {{ settings.name }}, {{ settings.place }}. <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>
    </div>
  </div>
  {#- Floating WhatsApp button on every page (Doc 05 Q11, Doc 06 Q07), inside the footer landmark. #}
  {%- if not hideWhatsApp %}
  <a class="whatsapp-float" href="https://wa.me/{{ settings.whatsapp_link }}?text={{ settings.whatsapp_message | urlencode }}" rel="noopener"{% if not settings.whatsapp %} data-placeholder="OD-14"{% endif %}>
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.1.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3Z"/></svg>
    <span>WhatsApp<span class="visually-hidden"> admissions (opens WhatsApp)</span></span>
  </a>
  {%- endif %}
</footer>
