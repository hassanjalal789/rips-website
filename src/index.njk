---
# Home (Doc 05 page inventory; Doc 06 Home checklist; CR-02 photo-led layout).
# Content order (Doc 06): header → headline and photo → Enquire / Programs / Admissions → admissions
# status → program cards (max 6) → latest notices (max 5) → why RIPS: campus photos, vision and mission
# → admissions band → contact → footer. The hero's buttons stay on the first screen of a 360 × 640
# phone. Every fact here is from settings, the program files or the RIPS campus tour video.
layout: base.njk
permalink: /
title: Health-science, computing and business degrees in Sheikhupura
description: "Radiant Institute of Professional Studies (RIPS), Sheikhupura: health-science, computing and business programs, admissions, notices and how to enquire."
bodyClass: home
preload:
  - { href: /assets/img/campus/front-aerial-1200.webp, media: "(min-width: 720px)" }
  - { href: /assets/img/campus/front-aerial-720.webp, media: "(max-width: 719px)" }
eleventyComputed:
  jsonld:
    "@context": https://schema.org
    "@type": EducationalOrganization
    name: "{{ settings.name }}"
    alternateName: "{{ settings.short_name }}"
    url: "{{ settings.url }}/"
    logo: "{{ settings.url }}/assets/img/crest.webp"
# Facilities seen in the RIPS campus tour video (https://www.youtube.com/watch?v=ccsk4uAyFLM). The photos are
# 16:9 stills from it, cropped clear of the video's logo overlay and subtitles, until commissioned photos (OD-12).
campus:
  - title: Anatomy lab
    text: Skeletons and anatomy models for learning the human body up close.
    img: anatomy-lab
    alt: Students gathered around a skeleton model in a RIPS lab, with anatomy models on the shelves behind them.
  - title: Science labs
    text: Lab benches, microscopes and equipment for practical classes.
    img: science-lab
    alt: Two students at work at a lab bench beside a glassware cabinet in a RIPS lab.
  - title: Computer lab
    text: Rows of desktop computers for hands-on classes.
    img: computer-lab
    alt: Students working at rows of desktop computers in the RIPS computer lab.
  - title: Library
    text: Shelves of books and long reading tables for quiet study.
    img: library
    alt: A student reading at a table in front of the library shelves at RIPS.
  - title: Classrooms
    text: Classrooms with whiteboards for lectures and discussion.
    img: classroom
    alt: A class of students at their desks while a teacher speaks at the whiteboard.
  - title: Student lounge
    text: A place to meet friends and talk between classes.
    img: student-lounge
    alt: Students sitting and talking at a long table in the RIPS student lounge.
---
{%- set intake = intakes[0] -%}
{%- set status = intake | intakeStatus(build.today) -%}
{%- set programs = collections.programs | activePrograms -%}
{%- set notices = collections.notices | currentNotices(build.today) -%}

<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-media">
    <source media="(min-width: 720px)" srcset="/assets/img/campus/front-aerial-1200.webp" width="1200" height="580">
    <img src="/assets/img/campus/front-aerial-720.webp" width="720" height="348" alt="The RIPS main building in {{ settings.place }}, seen from the air." fetchpriority="high">
  </picture>
  <div class="hero-body on-dark">
    <div class="wrap">
      <p class="eyebrow">{{ settings.name }}</p>
      <h1 id="hero-title">Health-science, computing and business degrees <em>in&nbsp;{{ settings.place }}</em></h1>
      <p class="hero-lead">{{ settings.tagline }}.</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href="/enquire/">Enquire</a>
        <a class="btn btn-ghost btn-lg" href="/programs/">Programs</a>
        <a class="btn btn-link" href="/admissions/">Admissions <span aria-hidden="true">→</span></a>
      </div>
      {%- if status %}
      <p class="hero-status">
        <span class="badge badge-{{ status.key }}">Admissions {{ status.label | lower }}</span>
        <span>{{ intake.session }} · closes {{ intake.closes_on | displayDate }}</span>
        {%- if intake.sample %} <span class="sample-tag">SAMPLE dates, OD-07</span>{% endif %}
      </p>
      {%- endif %}
    </div>
  </div>
</section>

<section class="band band-soft" aria-labelledby="programs-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Programs</p>
        <h2 id="programs-title">Choose your program</h2>
      </div>
      <a class="see-all" href="/programs/">See all programs <span aria-hidden="true">→</span></a>
    </div>
    <ul class="program-grid">
      {%- for p in programs.slice(0, 6) %}
      {%- set pstatus = (intakes | intakeFor(p.data.slug)) | intakeStatus(build.today) %}
      {%- set field = p.data.field %}
      <li class="program-card">
        <span class="program-icon-wrap">{% include "partials/program-icon.njk" %}</span>
        <h3><a href="/programs/{{ p.data.slug }}/">{{ p.data.title }}</a></h3>
        <p class="card-meta">{{ p.data.field }} · {{ p.data.level }}</p>
        <p class="program-foot">
          {%- if pstatus %}<span class="badge badge-{{ pstatus.key }}">{{ pstatus.label }}</span>{% endif %}
          {%- if not p.data.confirmed %} <span class="sample-tag">SAMPLE, OD-07</span>{% endif %}
        </p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="band" aria-labelledby="notices-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Notice board</p>
        <h2 id="notices-title">Latest notices</h2>
      </div>
      <a class="see-all" href="/notices/">All notices <span aria-hidden="true">→</span></a>
    </div>
    {%- if notices.length %}
    <ul class="notice-list">
      {%- for n in notices.slice(0, 5) %}
      {%- set headingTag = "h3" %}
      {% include "partials/notice-row.njk" %}
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="empty-state">There are no current notices. <a href="/notices/archive/">See the archive</a>.</p>
    {%- endif %}
  </div>
</section>

<section id="campus" class="band band-soft" aria-labelledby="why-title">
  <div class="wrap">
    <div class="intro-grid">
      <div>
        <p class="eyebrow">Why RIPS</p>
        <h2 id="why-title">A modern campus <em>in {{ settings.place }}</em></h2>
      </div>
      <div>
        <p class="lead">{{ settings.name }} (RIPS) is a private educational institute in {{ settings.place }}. It offers programs in health sciences, computing and business.</p>
        <p>The campus has an anatomy lab, science and computer labs, classrooms, a library and a student lounge, and a separate Admission Office building.</p>
        <div class="btn-row">
          <a class="btn btn-secondary" href="/about/">About RIPS</a>
          <a class="btn btn-text" href="https://www.youtube.com/watch?v=ccsk4uAyFLM" rel="noopener">Watch the campus tour <span class="small">(opens YouTube)</span></a>
        </div>
      </div>
    </div>
    <ul class="photo-grid">
      {%- for c in campus %}
      <li class="photo-card">
        <img src="/assets/img/campus/{{ c.img }}-640.webp" srcset="/assets/img/campus/{{ c.img }}-400.webp 400w, /assets/img/campus/{{ c.img }}-640.webp 640w" sizes="(min-width: 1024px) 23rem, (min-width: 600px) 45vw, 92vw" width="640" height="360" alt="{{ c.alt }}" loading="lazy">
        <h3>{{ c.title }}</h3>
        <p>{{ c.text }}</p>
      </li>
      {%- endfor %}
    </ul>
    <p class="photo-note">Photos are stills from the RIPS campus tour video. {% tbc "commissioned photography", "OD-12" %}</p>
  </div>
</section>

<section class="vision on-dark" aria-labelledby="vision-title">
  <div class="wrap vision-grid">
    <img class="vision-photo" src="/assets/img/campus/entrance-640.webp" srcset="/assets/img/campus/entrance-400.webp 400w, /assets/img/campus/entrance-640.webp 640w" sizes="(min-width: 1024px) 34rem, 92vw" width="640" height="360" alt="The main entrance of RIPS: white columns under the institute's sign and a small white dome." loading="lazy">
    <div class="vision-body">
      <p class="eyebrow">Who we are</p>
      <h2 id="vision-title">Vision and mission</h2>
      <h3>Our vision</h3>
      <p>{% tbc "vision, approved by the Chairman or Director", "Doc 05 Q13" %}</p>
      <h3>Our mission</h3>
      <p>{% tbc "mission, approved by the Chairman or Director", "Doc 05 Q13" %}</p>
      <p><a class="btn btn-ghost" href="/about/">Read more about RIPS</a></p>
    </div>
  </div>
</section>

<section class="admissions-band" aria-labelledby="admissions-title">
  <div class="wrap admissions-inner">
    <div>
      <p class="eyebrow">Admissions {{ intake.session }}</p>
      <h2 id="admissions-title">Start your application</h2>
      <p>Send a short enquiry and the admissions office will call you back. Every program page lists its duration, eligibility, fee and intake.</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-navy btn-lg" href="/enquire/">Enquire</a>
      <a class="btn btn-secondary btn-lg" href="/admissions/">How to apply</a>
    </div>
  </div>
</section>

<section class="band" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">Visit or contact us</h2>
    <ul class="contact-grid">
      <li>
        <h3>Visit</h3>
        <p>{{ settings.address | tbc("verified address", "OD-14") | safe }}</p>
        <p>Office hours: {{ settings.office_hours | tbc("office hours", "OD-14") | safe }}</p>
        {%- if settings.map_link %}
        <p><a href="{{ settings.map_link }}" rel="noopener">Get directions <span class="small">(opens Google Maps)</span></a></p>
        {%- else %}
        <p>Directions: {% tbc "Google Maps link", "OD-14" %}</p>
        {%- endif %}
      </li>
      <li>
        <h3>Call or WhatsApp</h3>
        <p>Phone: {{ settings.phone | tbc("admissions phone", "OD-14") | safe }}</p>
        <p>WhatsApp: {{ settings.whatsapp | tbc("WhatsApp number", "OD-14") | safe }}</p>
        <p><a href="tel:{{ settings.phone_link }}"{% if not settings.phone %} data-placeholder="OD-14"{% endif %}>Call admissions</a></p>
      </li>
      <li>
        <h3>Email</h3>
        <p>{{ settings.email | tbc("admissions email", "OD-04") | safe }}</p>
        <p><a href="/contact/">All contact details</a></p>
      </li>
    </ul>
  </div>
</section>
