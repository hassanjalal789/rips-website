---
# Home (Doc 05 page inventory; Doc 06 Home checklist). CR-05: ISL's homepage layout and opening sequence
# (CR-03 permission), built in RIPS's own code, words, crest and footage, near-black with RIPS gold.
# Order: dark header → three video panels from the RIPS tour video, with the crest, the name in gold, the
# Apply pill, Enquire and Programs links and the admissions status revealed over them → "Our campus"
# gold band and a full-width campus photo → vision and mission on a darkened campus photo → Why RIPS?
# (white lead-in, then a 3 × 2 grid of charcoal tiles) → learning at RIPS (framed photo) → programs by
# field on a blurred photo → latest notices (max 5) → four-column contact → footer. The hero's actions
# stay on the first screen of a 360 × 640 phone. Every fact is from settings, the program files or the
# RIPS campus tour video.
layout: base.njk
permalink: /
title: Health-science, computing and management programs in Sheikhupura
description: "Radiant Institute of Professional Studies (RIPS), Sheikhupura: BS and intermediate programs in health sciences, computing, management and the humanities, with admissions, notices and how to enquire."
bodyClass: home cine-page
pageScript: home
preload:
  - { href: /assets/img/campus/hero-learning.webp }
eleventyComputed:
  jsonld:
    "@context": https://schema.org
    "@type": EducationalOrganization
    name: "{{ settings.name }}"
    alternateName: "{{ settings.short_name }}"
    url: "{{ settings.url }}/"
    logo: "{{ settings.url }}/assets/img/crest.webp"
# Hero panels: clips from the RIPS campus tour video (https://www.youtube.com/watch?v=ccsk4uAyFLM), cropped
# clear of its logo overlay and subtitles, until commissioned footage arrives (OD-12).
panels: [campus, learning, life]
# Facilities seen in the tour video, linked to their part of the Why RIPS? page.
facilities:
  - { label: Labs, url: /why-rips/#labs }
  - { label: Computer lab, url: /why-rips/#computer-lab }
  - { label: Library, url: /why-rips/#library }
  - { label: Classrooms, url: /why-rips/#classrooms }
  - { label: Student lounge, url: /why-rips/#lounge }
  - { label: Admission Office, url: /why-rips/#admissions }
# Why RIPS? tiles: the title always shows; the text and a photo rise on hover or keyboard focus, and the
# text always shows on touch screens. Each links to its part of the Why RIPS? page.
why:
  - title: Programs for your career
    img: classroom
    id: programs
    text: BS and intermediate programs in health sciences, computing, management and the humanities.
  - title: Hands-on labs
    img: science-lab
    id: labs
    text: An anatomy lab with skeletons and models, and science labs for practical classes.
  - title: Computer lab
    img: computer-lab
    id: computer-lab
    text: Rows of desktop computers for hands-on computing classes.
  - title: Library
    img: library
    id: library
    text: Shelves of books and long reading tables for quiet study.
  - title: Student lounge
    img: student-lounge
    id: lounge
    text: A place to meet friends and talk between classes.
  - title: Admission Office
    img: admission-office
    id: admissions
    text: A separate Admission Office building on campus to help you choose a program and apply.
---
{%- set intake = intakes[0] -%}
{%- set status = intake | intakeStatus(build.today) -%}
{%- set programs = collections.programs | activePrograms -%}
{%- set notices = collections.notices | currentNotices(build.today) -%}
{%- set fields = programs | groupby("data.field") %}

{#- Opening: three tall video panels side by side; the crest, name and Apply pill fade up over them. The
    posters are the fallback: no JavaScript, reduced motion and Save-Data never load the videos (home.js). #}
<section class="isl-hero" aria-labelledby="hero-title">
  <div class="isl-panels" aria-hidden="true">
    {%- for p in panels %}
    <div class="isl-panel">
      <img src="/assets/img/campus/hero-{{ p }}.webp" width="384" height="512" alt=""{% if loop.index == 2 %} fetchpriority="high"{% endif %}>
      <video muted loop playsinline preload="none" tabindex="-1" data-mp4="/assets/video/panel-{{ p }}.mp4" data-webm="/assets/video/panel-{{ p }}.webm"></video>
    </div>
    {%- endfor %}
  </div>
  <div class="isl-brand">
    <img class="isl-crest" src="/assets/img/crest-gold.webp" alt="" width="148" height="145">
    <h1 id="hero-title" class="isl-wordmark">{{ settings.name }}</h1>
    <p class="isl-tagline">{{ settings.tagline }}</p>
    <a class="isl-pill" href="/admissions/">Apply for admission</a>
    <p class="isl-links"><a href="/enquire/">Enquire</a><span aria-hidden="true">·</span><a href="/programs/">Programs</a></p>
    {%- if status %}
    <p class="isl-status"{% if intake.sample %} data-draft="OD-07"{% endif %}>
      <span class="badge badge-{{ status.key }}">Admissions {{ status.label | lower }}</span>
      <span>{{ intake.session }} · closes {{ intake.closes_on | displayDate }}</span>
    </p>
    {%- endif %}
  </div>
  <button class="isl-pause" type="button" aria-pressed="false" hidden><span class="isl-pause-icon" aria-hidden="true"></span><span class="isl-pause-label">Pause videos</span></button>
</section>

{#- Our campus: a gold heading band, then the campus full width with its caption. RIPS has one campus. #}
<section id="campus" class="isl-campus" aria-labelledby="campus-title">
  <div class="isl-band">
    <h2 id="campus-title" class="reveal">Our campus</h2>
  </div>
  <div class="isl-campus-view">
    <img src="/assets/img/campus/front-aerial-1200.webp" srcset="/assets/img/campus/front-aerial-720.webp 720w, /assets/img/campus/front-aerial-1200.webp 1200w" sizes="100vw" width="1200" height="580" alt="The RIPS main building in {{ settings.place }}, seen from the air: a white dome over the entrance, red-brick wings and a paved forecourt." loading="lazy">
    <div class="isl-campus-caption reveal">
      <p class="isl-kicker">Main campus</p>
      <p class="isl-campus-name">{{ settings.place }}, Punjab</p>
      <ul class="isl-chips">
        {%- for f in facilities %}
        <li><a href="{{ f.url }}">{{ f.label }}</a></li>
        {%- endfor %}
      </ul>
      {%- if settings.map_link %}
      <a class="isl-pill isl-pill-sm" href="{{ settings.map_link }}" rel="noopener">Get directions <span class="visually-hidden">(opens Google Maps)</span></a>
      {%- endif %}
    </div>
  </div>
  <p class="isl-photo-note">Photos and video are from the RIPS campus tour.</p>
</section>

{#- Vision and mission over the campus at dusk; the key phrases in gold. #}
<section class="isl-statements" aria-label="Vision and mission">
  <img class="isl-bg" src="/assets/img/campus/front-dusk-854.webp" width="854" height="372" alt="" loading="lazy">
  <div class="isl-statements-inner">
    <div class="isl-statement reveal">
      <h2>Our <span>Vision</span></h2>
      <p>To be a leading institute in Pakistan for professional education, producing <strong>skilled, ethical and compassionate graduates</strong> who serve their communities and the nation.</p>
    </div>
    <div class="isl-statement isl-statement-end reveal">
      <h2>Our <span>Mission</span></h2>
      <p>To provide <strong>quality, affordable and industry-relevant education</strong> in health sciences, computing, management and the humanities, combining strong theory with <strong>hands-on practice</strong> so students become confident, responsible professionals.</p>
    </div>
  </div>
</section>

{#- Why RIPS?: a white lead-in, then six charcoal tiles with gold hairlines. #}
<section class="isl-why" aria-labelledby="why-title">
  <div class="isl-why-head reveal">
    <h2 id="why-title">Why RIPS?</h2>
    <p>{{ programs.length }} programs, hands-on labs, a library and a computer lab, on one campus in {{ settings.place }}.</p>
  </div>
  <ul class="isl-tiles">
    {%- for w in why %}
    <li class="isl-tile">
      <a href="/why-rips/#{{ w.id }}">
        <img src="/assets/img/campus/{{ w.img }}-400.webp" width="400" height="225" alt="" loading="lazy">
        <span class="isl-tile-title">{{ w.title }}</span>
        <span class="isl-tile-text">{{ w.text }}</span>
      </a>
    </li>
    {%- endfor %}
  </ul>
  <p class="isl-more"><a class="isl-pill isl-pill-solid" href="/why-rips/">View more</a></p>
</section>

{#- Learning at RIPS: heading, then a framed full-width photo. Temporary: a still from the tour video until
    a faculty photo is supplied (OD-12). #}
<section class="isl-learning" aria-labelledby="learning-title">
  <h2 id="learning-title" class="reveal">Learning at <span>RIPS</span></h2>
  <figure>
    <img src="/assets/img/campus/classroom-wide-1280.webp" srcset="/assets/img/campus/classroom-wide-720.webp 720w, /assets/img/campus/classroom-wide-1280.webp 1280w" sizes="(min-width: 1280px) 1200px, 100vw" width="1280" height="480" alt="A class of students at their desks while a teacher writes on the whiteboard at RIPS." loading="lazy">
    <figcaption data-asset="faculty photo">Temporary photo from the campus tour video, to be replaced with a photo of RIPS faculty.</figcaption>
  </figure>
</section>

{#- Programs: field buttons over a softly blurred campus photo, alternating gold and RIPS navy. #}
<section class="isl-programs" aria-labelledby="programs-title">
  <img class="isl-bg" src="/assets/img/campus/library-640.webp" width="640" height="360" alt="" loading="lazy">
  <h2 id="programs-title" class="reveal">Programs</h2>
  <ul class="isl-fields">
    {%- for field, items in fields %}
    <li><a class="isl-field" href="/programs/?field={{ field | urlencode }}">{{ field }}<span>{{ items.length }}<span class="visually-hidden"> program{{ "s" if items.length != 1 }}</span></span></a></li>
    {%- endfor %}
  </ul>
  <p class="isl-more"><a class="isl-pill" href="/programs/">See all {{ programs.length }} programs</a></p>
</section>

<section class="isl-notices" aria-labelledby="notices-title">
  <div class="isl-notices-inner">
    <div class="isl-notices-head">
      <h2 id="notices-title">Latest notices</h2>
      <a class="isl-pill isl-pill-sm" href="/notices/">All notices</a>
    </div>
    {%- if notices.length %}
    <ul class="notice-list">
      {%- for n in notices.slice(0, 5) %}
      {%- set headingTag = "h3" %}
      {% include "partials/notice-row.njk" %}
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="empty-state">There are no current notices. <a href="/notices/archive/">See the archive</a>.</p>
    {%- endif %}
  </div>
</section>

{#- Contact: four equal black columns divided by hairlines, white icons and gold headings. #}
<section class="isl-contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="visually-hidden">Contact RIPS</h2>
  <div class="isl-contact-grid">
    <div>
      <svg class="isl-icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.3" d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
      <h3>Address</h3>
      <p>{{ settings.address | tbc("verified address", "OD-14") | safe }}</p>
      {%- if settings.map_link %}
      <p><a class="isl-flat" href="{{ settings.map_link }}" rel="noopener">Get directions <span class="visually-hidden">(opens Google Maps)</span></a></p>
      {%- endif %}
    </div>
    <div>
      <svg class="isl-icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.3" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
      <h3>Phone</h3>
      <p class="isl-big"><a href="tel:{{ settings.phone_link }}"{% if not settings.phone %} data-placeholder="OD-14"{% endif %}>{{ settings.phone | tbc("admissions phone", "OD-14") | safe }}</a></p>
      <p class="isl-small">Office hours {{ settings.office_hours | tbc("office hours", "OD-14") | safe }}</p>
    </div>
    <div>
      <svg class="isl-icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true" focusable="false"><rect x="3" y="5.5" width="18" height="13" rx="1" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
      <h3>Email</h3>
      <p class="isl-email">{% if settings.email %}<a href="mailto:{{ settings.email }}">{{ settings.email | replace("@", "@<wbr>") | safe }}</a>{% else %}{% tbc "admissions email", "OD-04" %}{% endif %}</p>
    </div>
    <div>
      <svg class="isl-icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.3" d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3Z"/></svg>
      <h3>Connect</h3>
      <p><a class="isl-flat" href="https://wa.me/{{ settings.whatsapp_link }}?text={{ settings.whatsapp_message | urlencode }}" rel="noopener"{% if not settings.whatsapp %} data-placeholder="OD-14"{% endif %}>WhatsApp <span class="visually-hidden">(opens WhatsApp)</span></a></p>
      <p><a class="isl-flat" href="/enquire/">Enquire online</a></p>
    </div>
  </div>
</section>
